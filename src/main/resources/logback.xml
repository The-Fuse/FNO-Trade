<configuration>
    <appender name="OUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %logger{16} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="OUT"/>
    </root>
    <logger name="io.netty" level="WARN"/>
    <logger name="io.ktor" level="WARN"/>
</configuration>
