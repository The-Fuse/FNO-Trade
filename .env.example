# Copy to .env. Without UPSTOX_API_KEY the app runs on the simulated market.

# From https://account.upstox.com/developer/apps — the app's redirect URL must match UPSTOX_REDIRECT_URI.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8080/upstox/callback

# sim | upstox (default: upstox when an API key is set, else sim)
FEED=

PORT=8080

# Simulated market: IST time the session starts from, and how many market seconds pass per real second.
SIM_START=10:45
SIM_SPEED=30
